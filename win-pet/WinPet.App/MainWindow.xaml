<Window x:Class="WinPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPet" Width="360" Height="520"
        WindowStartupLocation="CenterScreen" Background="#F7F7F5"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="WINPET" FontSize="12" FontWeight="Bold" Opacity="0.55"/>
                <TextBlock Text="Your desktop companion" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="ActivityText" Text="Monitoring" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Opacity="0.55"/>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="26" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PetEmoji" Text="🐣" FontSize="104" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PetNameText" Text="Byte" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock x:Name="LevelText" Text="Level 1  •  0 XP" FontSize="13" Opacity="0.55" HorizontalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,8,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Energy" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="EnergyText" Grid.Column="1" Text="100%" FontSize="12" Opacity="0.6"/>
                    <ProgressBar x:Name="EnergyBar" Grid.Row="1" Grid.ColumnSpan="2" Height="7" Maximum="100" Margin="0,6,0,0"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Happiness" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="HappinessText" Grid.Column="1" Text="75%" FontSize="12" Opacity="0.6"/>
                    <ProgressBar x:Name="HappinessBar" Grid.Row="1" Grid.ColumnSpan="2" Height="7" Maximum="100" Margin="0,6,0,0"/>
                </Grid>
                <UniformGrid Grid.Row="3" Columns="3">
                    <TextBlock x:Name="TechnicalText" Text="Technical 0" FontSize="11" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock x:Name="KnowledgeText" Text="Knowledge 0" FontSize="11" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock x:Name="DisciplineText" Text="Discipline 0" FontSize="11" HorizontalAlignment="Center" Opacity="0.6"/>
                </UniformGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="Activity stays on this PC" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="11" Opacity="0.45"/>
    </Grid>
</Window>
