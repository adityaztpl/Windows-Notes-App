<Window x:Class="WinPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win Pet"
        Width="320"
        Height="420"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F2"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="24" Background="White" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🐣" FontSize="96" HorizontalAlignment="Center" />
                <TextBlock Text="Byte" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Level 1  •  0 XP" FontSize="14" Opacity="0.6" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Energy" FontSize="12" Opacity="0.65" />
            <ProgressBar Height="8" Value="82" Margin="0,6,0,10" />
            <TextBlock Text="Happiness" FontSize="12" Opacity="0.65" />
            <ProgressBar Height="8" Value="74" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Watching activity locally" HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="11" Opacity="0.5" />
    </Grid>
</Window>
